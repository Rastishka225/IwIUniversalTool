<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:IwIUniversalTool.Avalonia"
        x:Class="IwIUniversalTool.Avalonia.MainWindow"
        Width="1180" Height="760"
        MinWidth="900" MinHeight="520"
        Background="#1E1E1E"
        Title="IwI Universal Tool — Avalonia (M1.6)">

  <Window.Resources>
    <SolidColorBrush x:Key="WindowBg" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBg" Color="#252526"/>
    <SolidColorBrush x:Key="CardBg" Color="#2A2A2D"/>
    <SolidColorBrush x:Key="InputBg" Color="#333337"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#AAAAAA"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#3E3E42"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#00A2ED"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#B03A3A"/>
    <SolidColorBrush x:Key="LogBg" Color="#141414"/>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="#AAAAAA"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="#333337"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#3E3E42"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#00A2ED"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#B03A3A"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style Selector="TextBox.search">
      <Setter Property="Background" Value="#333337"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#3E3E42"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="7,4"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Styles>

  <DockPanel>

    <Border DockPanel.Dock="Top" Background="#252526" Padding="8" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="5">
        <Button x:Name="AddButton" Classes="tool" Content="Add files" Click="AddButton_Click"/>
        <Button x:Name="AddFolderButton" Classes="tool" Content="Add folder" Click="AddFolderButton_Click"/>
        <Button x:Name="RemoveButton" Classes="tool" Content="Remove selected" Click="RemoveButton_Click"/>
        <Button x:Name="ClearButton" Classes="tool" Content="Clear list" Click="ClearButton_Click"/>
        <Button x:Name="RefreshButton" Classes="tool" Content="Refresh" Click="RefreshButton_Click"/>
        <Button x:Name="PreviewButton" Classes="tool" Content="Preview" Click="PreviewButton_Click"/>
        <TextBox x:Name="SearchBox" Classes="search" Width="230" Watermark="Search by name…" TextChanged="SearchBox_TextChanged"/>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#252526" Padding="8,5" BorderBrush="#3E3E42" BorderThickness="0,1,0,0">
      <TextBlock x:Name="StatusText" Foreground="#AAAAAA" FontSize="11.5"/>
    </Border>

    <Grid ColumnDefinitions="248,*">

      <Border Grid.Column="0" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,0,1,0" Padding="12">
        <StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,1,0,12">
            <Border Width="38" Height="38" CornerRadius="8" Background="#00A2ED">
              <TextBlock Text="IWI" Foreground="White" FontWeight="Bold" FontSize="11"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="IwI Universal Tool" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14"/>
              <TextBlock Text="CoD texture converter" Foreground="#AAAAAA" FontSize="10.5"/>
            </StackPanel>
          </StackPanel>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
            <Button Grid.Column="0" Classes="accent" Content="Converter" Margin="0" Padding="6,5"/>
            <Button Grid.Column="1" Classes="tool" Content="Archives" Margin="0" Padding="6,5" IsEnabled="False" ToolTip.Tip="M2: IWD/IPAK"/>
          </Grid>

          <TextBlock Classes="section" Text="CALL OF DUTY VERSION"/>
          <ComboBox x:Name="GameBox" HorizontalAlignment="Stretch" FontSize="12"/>

          <TextBlock Classes="section" Text="MIPMAPS"/>
          <CheckBox x:Name="MipsBox" Content="Generate mipmaps" IsChecked="True" Foreground="#FFFFFF" FontSize="12"/>

          <TextBlock Classes="section" Text="SAVE TO"/>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="5">
            <Button x:Name="NearbyButton" Grid.Column="0" Classes="accent" Content="Nearby" Margin="0" Padding="6,5" Click="NearbyButton_Click"/>
            <Button x:Name="CustomButton" Grid.Column="1" Classes="tool" Content="Another folder" Margin="0" Padding="6,5" Click="CustomButton_Click"/>
          </Grid>
          <TextBox x:Name="OutputPathBox" IsReadOnly="True" Margin="0,5,0,0" FontSize="11"
                   Background="#333337" Foreground="#AAAAAA" BorderBrush="#3E3E42" CornerRadius="5" Padding="5,3"
                   Watermark="next to source file"/>

          <TextBlock Classes="section" Text="ACTIONS"/>
          <Button x:Name="ConvertAllButton" Classes="accent" Content="Convert all" Click="ConvertAll_Click"/>
          <Button x:Name="ConvertSelectedButton" Classes="tool" Content="Convert selected" Click="ConvertSelected_Click" Margin="0,5,0,0"/>
          <Button x:Name="StopButton" Classes="danger" Content="Stop" Click="StopButton_Click" IsEnabled="False"/>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,180" Margin="8">

        <DockPanel Grid.Row="0">
          <Border DockPanel.Dock="Top" Background="#2A2A2D" CornerRadius="7,7,0,0" Padding="8,5" BorderBrush="#3E3E42" BorderThickness="1">
            <Grid ColumnDefinitions="3*,0.7*,0.9*,4*,1.1*">
              <TextBlock Grid.Column="0" Text="Name" Foreground="#AAAAAA" FontSize="10.5"/>
              <TextBlock Grid.Column="1" Text="Type" Foreground="#AAAAAA" FontSize="10.5"/>
              <TextBlock Grid.Column="2" Text="Size" Foreground="#AAAAAA" FontSize="10.5"/>
              <TextBlock Grid.Column="3" Text="Path" Foreground="#AAAAAA" FontSize="10.5"/>
              <TextBlock Grid.Column="4" Text="Status" Foreground="#AAAAAA" FontSize="10.5"/>
            </Grid>
          </Border>
          <Border Background="#252526" BorderBrush="#3E3E42" BorderThickness="1,0,1,1" CornerRadius="0,0,7,7">
            <ListBox x:Name="FilesList" Background="Transparent" BorderThickness="0"
                     SelectionMode="Multiple" SelectionChanged="FilesList_SelectionChanged"
                     DoubleTapped="FilesList_DoubleTapped">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="local:TextureItem">
                  <Grid ColumnDefinitions="3*,0.7*,0.9*,4*,1.1*" Margin="3,1">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="#FFFFFF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding Type}" Foreground="#AAAAAA" FontSize="10.5"/>
                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="#AAAAAA" FontSize="10.5"/>
                    <TextBlock Grid.Column="3" Text="{Binding Path}" Foreground="#777777" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="4" Text="{Binding Status}" Foreground="#AAAAAA" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
        </DockPanel>

        <Border Grid.Row="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="1" CornerRadius="7" Margin="0,8,0,0">
          <DockPanel Margin="7">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="Log" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" x:Name="LogStatus" Text="" Foreground="#AAAAAA" FontSize="10.5" VerticalAlignment="Center"/>
            </Grid>
            <TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     Background="#141414" Foreground="#CCCCCC" BorderThickness="0" CornerRadius="5"
                     FontFamily="Consolas,Menlo,monospace" FontSize="11" Margin="0,5,0,0"/>
          </DockPanel>
        </Border>

      </Grid>
    </Grid>
  </DockPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IwIUniversalTool.Avalonia.AboutWindow"
        Width="470" Height="330"
        CanResize="False"
        Background="#1E1E1E"
        Title="About IwI Universal Tool">
  <StackPanel Margin="22" Spacing="8">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Border Width="40" Height="40" CornerRadius="8" Background="#00A2ED">
        <TextBlock Text="IWI" Foreground="White" FontWeight="Bold" FontSize="11"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="IwI Universal Tool" Foreground="#FFFFFF" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Text="Avalonia M1.8" Foreground="#AAAAAA" FontSize="11"/>
      </StackPanel>
    </StackPanel>

    <TextBlock Text="Call of Duty texture converter: IWI, DDS, PNG, TGA, VTF, IWD/IPAK."
               Foreground="#CCCCCC" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
    <TextBlock Text="Unofficial project. Not affiliated with Activision, Infinity Ward, Treyarch or Plutonium."
               Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap"/>
    <TextBlock Text="MIT License" Foreground="#AAAAAA" FontSize="11"/>

    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,14,0,0">
      <Button Content="GitHub" Click="GitHub_Click" Padding="12,5" CornerRadius="5"
              Background="#333337" Foreground="#FFFFFF" BorderBrush="#3E3E42" BorderThickness="1"/>
      <Button Content="Close" Click="Close_Click" Padding="12,5" CornerRadius="5"
              Background="#00A2ED" Foreground="#FFFFFF" BorderThickness="0"/>
    </StackPanel>
  </StackPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="IwIUniversalTool.Avalonia.PreviewWindow"
        Width="900" Height="650"
        MinWidth="520" MinHeight="360"
        Background="#1E1E1E"
        Title="Preview">
  <Grid RowDefinitions="*,Auto">
    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="10"/>
    <Border Grid.Row="1" Background="#252526" BorderBrush="#3E3E42" BorderThickness="0,1,0,0" Padding="10,6">
      <TextBlock x:Name="InfoText" Foreground="#AAAAAA" FontSize="11.5"/>
    </Border>
  </Grid>
</Window>

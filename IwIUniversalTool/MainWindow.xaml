                        <TextBlock x:Name="TxtModeHint" Text="" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}" Margin="2,8,0,0"/>

                        <TextBlock x:Name="TxtSaveDirLabel" Text="КУДА СОХРАНЯТЬ" Style="{StaticResource SectionLabelStyle}"/>

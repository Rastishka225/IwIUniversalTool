                </ScrollViewer>

                <!-- ================= РЕЖИМ «АРХИВЫ»: НАСТРОЙКИ УПАКОВКИ ================= -->
                <ScrollViewer x:Name="PnlArchiveSettings" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,0,8" Visibility="Collapsed">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock x:Name="LblPackName" Text="ИМЯ АРХИВА" Style="{StaticResource SectionLabelStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="TxtArchiveName" Padding="8,8,88,8" TextChanged="TxtArchiveName_TextChanged"
                                         GotKeyboardFocus="TxtArchiveName_FocusChanged" LostKeyboardFocus="TxtArchiveName_FocusChanged"
                                         PreviewKeyDown="TxtArchiveName_PreviewKeyDown"/>
                                <TextBlock x:Name="TxtNamePlaceholder" Text="iw_collect" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="9,0,88,0" IsHitTestVisible="False"/>
                                <TextBlock x:Name="TxtPackExt" Text=".iwd" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,38,0" IsHitTestVisible="False"/>
                                <ToggleButton x:Name="BtnArchivePick" HorizontalAlignment="Right" VerticalAlignment="Center" Width="32" Height="30" Margin="0,0,3,0"
                                              Focusable="False" Cursor="Hand" Click="BtnArchivePick_Click">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                                            <Border Background="Transparent">
                                                <Path x:Name="ArrowGlyph" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="ArrowAngle" Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ArrowGlyph" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ArrowAngle" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseInOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ArrowAngle" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseInOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- Список архивов из папки выбранной версии игры -->
                                <Popup x:Name="PopArchives" PlacementTarget="{Binding ElementName=TxtArchiveName}" Placement="Bottom" VerticalOffset="4"
                                       StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" Opened="PopArchives_Opened" Closed="PopArchives_Closed">
                                    <Border Width="{Binding ActualWidth, ElementName=TxtArchiveName}" Margin="0,0,12,12" CornerRadius="9" Padding="4"
                                            Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <ListBox x:Name="LstArchives" MaxHeight="240" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="LstArchives_PreviewMouseUp">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="8,5"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="ItemBd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="ItemBd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                                            <Setter Property="Foreground" Value="White"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding FullDisplay}" ToolTipService.ShowDuration="30000"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding SizeText}" Margin="12,0,0,0" Opacity="0.6"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock x:Name="TxtArchivesEmpty" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="8,6,8,8" Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                            <Button x:Name="BtnArchiveContents" Grid.Column="1" Style="{StaticResource ToolButtonStyle}" Margin="6,0,0,0"
                                    Width="58" Height="NaN" VerticalAlignment="Stretch" Padding="0" Click="BtnArchiveContents_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7B8;" FontSize="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#x21B7;" FontFamily="Segoe UI Symbol" FontSize="17" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="LblPackVersion" Text="ВЕРСИЯ CALL OF DUTY" Style="{StaticResource SectionLabelStyle}"/>
                        <ComboBox x:Name="CmbPackVersion" SelectedIndex="4" SelectionChanged="CmbPackVersion_SelectionChanged">
                            <ComboBoxItem Content="Black Ops 2 (v27)"/>
                            <ComboBoxItem Content="Modern Warfare 3 (v8)"/>
                            <ComboBoxItem Content="Black Ops (v13)"/>
                            <ComboBoxItem Content="Modern Warfare 2 (v8)"/>
                            <ComboBoxItem Content="World at War (v6)"/>
                            <ComboBoxItem Content="Modern Warfare (v6)"/>
                            <ComboBoxItem Content="Call of Duty 2 (v5)"/>
                        </ComboBox>
                        <TextBlock x:Name="LblPackFormat" Text="ФОРМАТ АРХИВА" Style="{StaticResource SectionLabelStyle}"/>
                        <Border Background="{DynamicResource InputBgBrush}" CornerRadius="9" Padding="2" Height="32">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="RbFmtIpak" GroupName="PackFormatGroup" Content="IPAK" Style="{StaticResource SegmentRadioStyle}" Checked="PackFormat_Changed"/>
                                <RadioButton x:Name="RbFmtIwd" GroupName="PackFormatGroup" Content="IWD" Grid.Column="1" IsChecked="True" Style="{StaticResource SegmentRadioStyle}" Checked="PackFormat_Changed"/>
                            </Grid>
                        </Border>
                        



                        <TextBlock x:Name="LblPackOptions" Text="ПАРАМЕТРЫ" Style="{StaticResource SectionLabelStyle}"/>
                        <CheckBox x:Name="ChkPackKeepOriginal" Content="Сохранять оригинал при замене" Margin="0,0,0,8"/>
                        <CheckBox x:Name="ChkPackReplace" Content="Заменять файлы с тем же именем" IsChecked="True"/>

                        <TextBlock x:Name="LblPackSaveTo" Text="КУДА СОХРАНЯТЬ" Style="{StaticResource SectionLabelStyle}"/>
                        <Border Background="{DynamicResource InputBgBrush}" CornerRadius="9" Padding="2" Height="32">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="RbPackSaveNearby" GroupName="PackSaveGroup" Content="Рядом" IsChecked="True" Style="{StaticResource SegmentRadioStyle}" Checked="PackSaveLocation_Changed"/>
                                <RadioButton x:Name="RbPackSaveCustom" GroupName="PackSaveGroup" Content="Другая папка" Grid.Column="1" Style="{StaticResource SegmentRadioStyle}" Checked="PackSaveLocation_Changed"/>
                            </Grid>
                        </Border>
                        <Grid x:Name="PnlPackCustomPath" Margin="0,8,0,0" Opacity="0.55" IsEnabled="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtPackCustomPath" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="…" Width="40" Style="{StaticResource ToolButtonStyle}" Margin="0" Click="BtnPackBrowse_Click"/>
                        </Grid>
                        <Button x:Name="BtnPackShowFolder" Content="Открыть папку с результатом" Style="{StaticResource ToolButtonStyle}" Margin="0,10,0,0" Click="BtnPackShowFolder_Click"/>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="PnlConvertBottom" Grid.Row="3">
                    <TextBlock x:Name="TxtDoneLabel" Text="ГОТОВЫЕ ФАЙЛЫ" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,5"/>
                    <Border Background="{DynamicResource InputBgBrush}" CornerRadius="9" Padding="2" Height="32" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RbDoneAuto" GroupName="DoneModeGroup" Content="Авто" IsChecked="True" Style="{StaticResource SegmentRadioStyle}"/>
                            <RadioButton x:Name="RbDoneSkip" GroupName="DoneModeGroup" Content="Пропускать" Grid.Column="1" Style="{StaticResource SegmentRadioStyle}"/>
                            <RadioButton x:Name="RbDoneRedo" GroupName="DoneModeGroup" Content="Заново" Grid.Column="2" Style="{StaticResource SegmentRadioStyle}"/>
                        </Grid>
                    </Border>
                    <Button x:Name="BtnConvertAll" Content="Конвертировать всё" Background="#007ACC" FontWeight="Bold" FontSize="14" Height="36" Margin="0,0,0,6" Click="BtnConvertAll_Click"/>
                    <Button x:Name="BtnConvertSelected" Content="Конвертировать выбранные" Background="#0F8B7E" FontWeight="SemiBold" Height="32" Margin="0,0,0,6" Click="BtnConvertSelected_Click"/>
                    <Button x:Name="BtnPause" Content="Пауза" Background="#E08A00" FontWeight="SemiBold" Height="30" Margin="0,0,0,6" Visibility="Collapsed" Click="BtnPause_Click"/>
                    <Button x:Name="BtnStop" Content="Остановить" Background="#C93C3C" FontWeight="SemiBold" Height="30" IsEnabled="False" Click="BtnStop_Click"/>
                </StackPanel>

                <!-- Нижние кнопки режима «Архивы» -->
                <StackPanel x:Name="PnlArchiveBottom" Grid.Row="3" Visibility="Collapsed">
                    <TextBlock x:Name="LblPackCompression" Text="СЖАТИЕ АРХИВА" Style="{StaticResource SectionLabelStyle}"/>
                    <Border x:Name="BrdPackCompression" Background="{DynamicResource InputBgBrush}" CornerRadius="9" Padding="2" Height="32">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <RadioButton x:Name="RbCompMax" ToolTipService.InitialShowDelay="5000" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" GroupName="PackCompGroup" Content="Максимум" Style="{StaticResource SegmentRadioStyle}" Checked="PackCompression_Changed"/>
                            <RadioButton x:Name="RbCompNormal" ToolTipService.InitialShowDelay="5000" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" GroupName="PackCompGroup" Content="Обычно" Grid.Column="1" IsChecked="True" Style="{StaticResource SegmentRadioStyle}" Checked="PackCompression_Changed"/>
                            <RadioButton x:Name="RbCompNone" ToolTipService.InitialShowDelay="5000" ToolTipService.ShowDuration="20000" ToolTipService.ShowOnDisabled="True" GroupName="PackCompGroup" Content="Без сжатия" Grid.Column="2" Style="{StaticResource SegmentRadioStyle}" Checked="PackCompression_Changed"/>
                        </Grid>
                    </Border>
                                        <Border Height="10"/>
                    <Button x:Name="BtnPackAll" Content="УПАКОВАТЬ" FontWeight="Bold" FontSize="14" Height="36" Margin="0,0,0,6" Click="BtnPackAll_Click">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#7C4DFF" Offset="0"/>
                                <GradientStop Color="#C13FD6" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                    <Button x:Name="BtnPackSelected" Content="Упаковать выбранные" Background="#0F8B7E" FontWeight="SemiBold" Height="32" Margin="0,0,0,6" Click="BtnPackSelected_Click"/>
                    <Button x:Name="BtnPackRecompress" Content="Сжать архив" Style="{StaticResource ToolButtonStyle}" Margin="0,0,0,6" Click="BtnPackRecompress_Click"/>
                    <Button x:Name="BtnPackStop" Content="Остановить" Background="#C93C3C" FontWeight="SemiBold" Height="30" IsEnabled="False" Click="BtnPackStop_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ПРАВАЯ ЧАСТЬ: СПИСОК ФАЙЛОВ -->
        <Grid Grid.Column="1" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="130"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnAddFiles" Content="Добавить файлы" Style="{StaticResource ToolButtonStyle}" Click="BtnAddFiles_Click"/>
                    <Button x:Name="BtnAddFolder" Content="Добавить папку" Style="{StaticResource ToolButtonStyle}" Click="BtnAddFolder_Click"/>
                    <Button x:Name="BtnRemoveSelected" Content="Убрать выбранные" Style="{StaticResource ToolButtonStyle}" Click="BtnRemoveSelected_Click"/>
                    <Button x:Name="BtnClear" Content="Очистить список" Style="{StaticResource ToolButtonStyle}" Foreground="#E5534B" Click="BtnClear_Click"/>
                    <Button x:Name="BtnRefresh" Style="{StaticResource ToolButtonStyle}" Width="32" Padding="0" Click="BtnRefresh_Click" ToolTip="Обновить">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="14"/>
                    </Button>
                    <Button x:Name="BtnPreview" Style="{StaticResource ToolButtonStyle}" Width="32" Padding="0" Click="BtnPreview_Click" ToolTip="Предпросмотр (P)">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7B3;" FontSize="16"/>
                    </Button>
                </StackPanel>

                <Grid Grid.Column="1" Margin="8,0,2,0" VerticalAlignment="Center" HorizontalAlignment="Stretch" MinWidth="120">
                    <TextBox x:Name="TxtSearch" Padding="30,8,28,8" TextChanged="TxtSearch_TextChanged"
                             GotKeyboardFocus="TxtSearch_FocusChanged" LostKeyboardFocus="TxtSearch_FocusChanged"/>
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="TxtSearchLabel" Text="Поиск по имени…" Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="31,0,0,0" IsHitTestVisible="False"/>
                    <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Width="24" Height="24" Padding="0" Margin="0,0,6,0"
                            Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Click="BtnClearSearch_Click"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="1">
                <Border x:Name="ListCard" CornerRadius="12" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0" SizeChanged="ListCard_SizeChanged">
                    <DataGrid x:Name="GridFiles" PreviewKeyDown="GridFiles_PreviewKeyDown" PreviewMouseLeftButtonDown="GridFiles_PreviewMouseLeftButtonDown" PreviewMouseDown="GridFiles_PreviewMouseDown" PreviewMouseWheel="GridFiles_PreviewMouseWheel" AutoGenerateColumns="False" CanUserSortColumns="True" CanUserResizeColumns="True"
                          VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="GridFiles_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="ColFileName" Header="Имя файла" Binding="{Binding FileName}" SortMemberPath="FileName" Width="3*" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn x:Name="ColFileType" Header="Тип" Binding="{Binding FileType}" SortMemberPath="FileType" Width="0.8*" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn x:Name="ColFileSize" Header="Размер" Binding="{Binding FileSize}" SortMemberPath="FileSizeBytes" Width="1.1*" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn x:Name="ColFullPath" Header="Путь" Binding="{Binding FullPath}" SortMemberPath="FullPath" Width="4*" ElementStyle="{StaticResource CellTextStyle}"/>
                            <DataGridTextColumn x:Name="ColStatus" Header="Статус" Binding="{Binding Status}" SortMemberPath="Status" Width="1.2*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding State}" Value="Pending"/>
                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding State}" Value="Done"/>
                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding State}" Value="Error"/>
                                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Foreground" Value="{StaticResource ErrBrush}"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- ПОДСКАЗКА ПРИ ПЕРЕТАСКИВАНИИ: только поверх списка файлов -->
                <Border x:Name="DropOverlay" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="12"
                    Background="#E60B3A66" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="+" FontSize="56" FontWeight="Light" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtDropHint" Text="Отпустите файлы или папки здесь" FontSize="18" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="PNG · TGA · DDS · IWI · VTF · ZIP · 7Z · RAR · IWD" FontSize="12.5" Foreground="#CCFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="TxtStatusCount" Grid.Row="2" Text="Файлов: 0 · выбрано: 0" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="4,8,0,0"/>
        </Grid>

        <!-- ПРАВАЯ ЧАСТЬ: ЖУРНАЛ И ПРОГРЕСС -->
        <Border Grid.Column="1" Grid.Row="1" Margin="0,12,0,0" Height="236" CornerRadius="12"
                Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtLogsHeader" Grid.Column="0" Text="Журнал" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <Grid Grid.Column="1" Margin="14,0,4,0" VerticalAlignment="Center" MinWidth="110">
                        <TextBox x:Name="TxtLogSearch" Padding="8,4" FontSize="12" TextChanged="TxtLogSearch_TextChanged"
                                 GotKeyboardFocus="TxtLogSearch_FocusChanged" LostKeyboardFocus="TxtLogSearch_FocusChanged"/>
                        <TextBlock x:Name="TxtLogSearchHint" Text="Поиск в журнале…" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                                   VerticalAlignment="Center" Margin="9,0,0,0" IsHitTestVisible="False"/>
                    </Grid>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <CheckBox x:Name="ChkErrorsOnly" Content="Смотреть ошибки" VerticalAlignment="Center" Margin="6,0,0,0" Click="ChkErrorsOnly_Click"/>
                        <CheckBox x:Name="ChkClearLogsAfter" Content="Автоочистка" VerticalAlignment="Center" Margin="14,0,0,0"/>
                        <Button x:Name="BtnExportLogs" Content="Сохранить…" Style="{StaticResource SmallButtonStyle}" Click="BtnExportLogs_Click"/>
                        <Button x:Name="BtnClearLogs" Content="Очистить" Style="{StaticResource SmallButtonStyle}" Click="BtnClearLogs_Click"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="PbProgress" Height="18" Maximum="100" Value="0"/>
                    <TextBlock x:Name="TxtProgressPercent" Text="0% (0 / 0)" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="TxtElapsed" Grid.Column="1" Text="00:00" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" TextAlignment="Right" Margin="12,0,0,0" MinWidth="46"/>
                </Grid>

                <Border Grid.Row="2" CornerRadius="8" Background="{DynamicResource LogBgBrush}">
                    <RichTextBox x:Name="RtbLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="Transparent"
                                 BorderThickness="0" Padding="8,6,6,6" FontFamily="Consolas" FontSize="12">
                        <FlowDocument/>
                    </RichTextBox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
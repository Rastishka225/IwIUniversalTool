                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="RbFixedIwi" GroupName="FixedChocolateTiles" Content="IWI" IsChecked="True" Style="{StaticResource SegmentRadioStyle}"/>
                                <RadioButton x:Name="RbFixedPng" GroupName="FixedChocolateTiles" Content="PNG" Grid.Column="1" Style="{StaticResource SegmentRadioStyle}"/>
                                <RadioButton x:Name="RbFixedTga" GroupName="FixedChocolateTiles" Content="TGA" Grid.Column="2" Style="{StaticResource SegmentRadioStyle}"/>

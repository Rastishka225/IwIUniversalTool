                            </Grid>
                        </Border>

                        <Grid x:Name="PnlCustomPath" Margin="0,8,0,0" Opacity="0.55" IsEnabled="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>

		<!-- ОФОРМЛЕНИЕ ПРИЛОЖЕНИЯ ДЛЯ РЕЛИЗА -->
		<ApplicationIcon>app.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AssemblyTitle>IwI Universal Tool</AssemblyTitle>
		<Product>IwI Universal Tool</Product>
		<Description>Конвертер текстур Call of Duty: IWI, DDS, PNG, TGA (в том числе из архивов ZIP, 7Z, RAR, IWD)</Description>
		<Version>1.3.0</Version>
		<Copyright>© IwI Universal Tool</Copyright>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>

		<!-- МЕНЬШЕ ПАМЯТИ В ПОКОЕ -->
		<ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
		<ServerGarbageCollector>false</ServerGarbageCollector>
		<TieredPGO>false</TieredPGO>

		<!-- НАСТРОЙКИ СБОРКИ В ОДИН ФАЙЛ -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PublishSingleFile>true</PublishSingleFile>
		<SelfContained>true</SelfContained>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

		<!-- ВЫКЛЮЧАЕМ МУСОР И ЛИШНИЙ ВЕС -->
		<PublishReadyToRun>false</PublishReadyToRun>
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
		<PackageReference Include="Magick.NET-Q8-x64" Version="14.17.2" />
		<PackageReference Include="SharpCompress" Version="0.48.0" />
	</ItemGroup>


	<!-- Компонент миниатюр проводника (IwiThumbs) собирается отдельно: из этого проекта его файлы исключаем -->
	<ItemGroup>
		<Compile Remove="IwiThumbs\**" />
		<EmbeddedResource Remove="IwiThumbs\**" />
		<None Remove="IwiThumbs\**" />
		<Page Remove="IwiThumbs\**" />
		<Compile Remove="Thumbnails\**" />
		<None Remove="Thumbnails\**" />
	</ItemGroup>

</Project>